{
  "name": "zaptian-id-designer",
  "version": "1.0.2",
  "description": "Zaptian ID Designer – Windows ID Card Design Tool",
  "author": "Zaptian",
  "license": "MIT",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run electron:dev\" \"npm run vite\"",
    "electron:dev": "electronmon electron/main.js .",
    "dev": "electronmon .",
    "vite": "vite",
    "build_vite": "vite build",
    "build": "electron-builder --win --x64",
    "publish": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.3",
    "electron-log": "^4.4.7",
    "electron-store": "^9.0.0",
    "electron-updater": "^6.1.8",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.563.0",
    "mime-types": "^3.0.2",
    "node-fetch": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "react-virtualized": "^9.22.6",
    "react-window": "^2.2.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "electron": "^37.10.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "com.zaptian.iddesigner",
    "productName": "Zaptian ID Designer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "out/**/*",
      "electron/**/*",
      "!/*.map",
      "!/*.ts",
      "!/_tests_",
      "!/*.md",
      "!node_modules//*.{md,ts,map}",
      "!node_modules//test",
      "!node_modules//example",
      "!node_modules//demo",
      "!/node_modules//test/*",
      "!/node_modules//examples/*",
      "!/node_modules//demo/*"
    ],
    "win": {
      "icon": "public/assets/Logo/logo_512.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "compression": "maximum"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zaptian",
        "repo": "ZCards",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zaptian ID Designer",
      "installerIcon": "public/assets/Logo/logo_512.ico",
      "uninstallerIcon": "public/assets/Logo/logo_512.ico",
      "installerHeaderIcon": "public/assets/Logo/logo_512.ico",
      "license": "public/License/LICENSE.txt"
    }
  }
}
